{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@org/shared": ["./libs/shared/src/index.ts"],
      "@org/types": ["./libs/types/src/index.ts"],
      "@org/auth": ["./libs/auth/src/index.ts"],
      "@org/database": ["./libs/database/src/index.ts"],
      "@org/ui": ["./libs/ui/src/index.ts"]
    }
  }
}
