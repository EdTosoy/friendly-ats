{
  "name": "@fats/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@fats/domain": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "nx": {
    "name": "job-tracker-web",
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.next"
        ],
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "command": "pnpm --filter @fats/web build"
      },
      "typecheck": {
        "cache": true,
        "command": "pnpm --filter @fats/web typecheck"
      },
      "lint": {
        "cache": true,
        "command": "pnpm --filter @fats/web lint"
      },
      "dev": {
        "command": "pnpm --filter @fats/web dev",
        "continuous": true
      },
      "start": {
        "command": "pnpm --filter @fats/web start",
        "continuous": true
      }
    },
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/tsconfig.tracker.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml"
      ]
    }
  },
  "type": "module",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
