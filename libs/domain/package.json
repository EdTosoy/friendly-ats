{
  "name": "@fats/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "nx": {
    "name": "job-tracker-domain",
    "tags": [
      "type:domain"
    ],
    "targets": {
      "typecheck": {
        "cache": true
      },
      "lint": {
        "cache": true
      }
    },
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/tsconfig.tracker.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ]
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0"
  }
}
